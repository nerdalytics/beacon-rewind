{
	"author": "Denny Trebbin (nerdalytics)",
	"description": "Persist Beacon state. Rewind when you need to.",
	"devDependencies": {
		"@biomejs/biome": "2.3.14",
		"@nerdalytics/beacon": "1000.3.0",
		"@types/node": "25.2.2",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"exports": {
		".": {
			"import": {
				"default": "./dist/src/index.js",
				"types": "./dist/src/index.d.ts"
			},
			"types": "./dist/src/index.d.ts",
			"typescript": "./src/index.ts"
		}
	},
	"files": [
		"dist/src/**/*.js",
		"dist/src/**/*.d.ts",
		"src/**/*.ts",
		"LICENSE"
	],
	"keywords": [
		"beacon",
		"nodejs",
		"persistence",
		"reactive",
		"rewind",
		"signals",
		"sqlite",
		"state-management",
		"time-travel",
		"typescript"
	],
	"license": "MIT",
	"main": "dist/src/index.js",
	"name": "@nerdalytics/beacon-rewind",
	"packageManager": "npm@11.9.0",
	"peerDependencies": {
		"@nerdalytics/beacon": "^1000.3.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nerdalytics/beacon-rewind.git"
	},
	"scripts": {
		"build": "npm run build:lts",
		"build:lts": "tsc -p tsconfig.lts.json",
		"example:basic-usage": "node examples/basic-usage.ts",
		"example:persistence": "node examples/persistence-demo.ts",
		"prebuild:lts": "rm -rf dist/",
		"prepublishOnly": "npm run build:lts",
		"test": "node --test --experimental-test-coverage tests/**/*.test.ts",
		"update-dependencies": "npx npm-check-updates --interactive --upgrade --removeRange"
	},
	"sideEffects": false,
	"type": "module",
	"types": "dist/src/index.d.ts",
	"version": "1.0.0"
}
