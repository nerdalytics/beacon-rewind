{
	"$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
	"extends": "//",
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**/*.ts",
			"!test.template.ts"
		]
	},
	"linter": {
		"rules": {
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "off"
				}
			},
			"suspicious": {
				"noConsole": "off"
			}
		}
	}
}
